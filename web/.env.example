# --- Frontend (Vite) ---
# Sanity CMS (optional — the site works with local content if unset)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# --- Serverless functions (Vercel) ---
# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret (https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (https://resend.com/api-keys) — thank-you emails
RESEND_API_KEY=re_...
# Verified sender (after adding your domain in Resend)
EMAIL_FROM="Casa Esperança Real Crescer <contato@casaesperancarealcrescer.org>"

# Public site URL (used for Stripe redirect URLs)
SITE_URL=https://www.casaesperancarealcrescer.org
