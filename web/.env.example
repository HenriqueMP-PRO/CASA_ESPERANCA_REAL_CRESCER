# --- Frontend (Vite) ---
# Sanity CMS (optional — the site works with local content if unset)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Confirm the Pix key is registered to the Banco do Brasil account before enabling.
# Public receiving key, not a credential. Leave blank until verified.
VITE_BB_PIX_KEY=
# Confirmed account holder CNPJ for manual Pix by bank details (not a Pix key).
VITE_BB_ACCOUNT_CNPJ=

# Optional Brazilian card gateway with later transfer to BB; disabled until configured.
# Enable only after configuring/testing the association's Mercado Pago account.
# This public flag also gates the Brazilian server endpoint. Redeploy after changes.
VITE_BRAZIL_PAYMENTS_ENABLED=false

# --- Serverless functions (Vercel) ---
# Stripe — international donations only (USD/EUR/GBP).
# BRL uses direct BB Pix (optional card gateway) and requires no Stripe keys.
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret (https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Mercado Pago Checkout Pro — Brazil, one-time donations (server secret only).
MERCADO_PAGO_ACCESS_TOKEN=

# Resend (https://resend.com/api-keys) — thank-you emails
RESEND_API_KEY=re_...
# Verified sender (after adding your domain in Resend)
EMAIL_FROM="Casa Esperança Real Crescer <contato@casaesperancarealcrescer.org>"

# Public HTTPS site URL (used for payment redirect URLs)
SITE_URL=https://www.casaesperancarealcrescer.org
